{
  "distro": {
    "name": "Fyntora",
    "version": "1.0",
    "arch": "x86_64",
    "description": "Professional Linux Distro"
  },
  "packages": {
    "base": ["filesystem", "glibc", "bash", "coreutils", "systemd"],
    "extra": ["vim", "git"],
    "repos": ["http://download.opensuse.org/distribution/leap/15.5/repo/oss/"]
  },
  "kernel": {
    "version": "6.6",
    "config": "config/kernel.config"
  },
  "init": "systemd",
  "bootloader": "grub",
  "output": "build/fyntora.iso"
}
{
  "distro": {
    "name": "Fyntora",
    "version": "1.0",
    "arch": "x86_64",
    "description": "Professional Linux Distro"
  },
  "host_os": "ubuntu",
  "target_base": "ubuntu",
  "target_version": "noble",
  "packages": {
    "base": ["base-files", "libc6", "bash", "coreutils", "systemd"],
    "extra": ["vim", "git"],
    "repos": ["http://archive.ubuntu.com/ubuntu/ noble main restricted"]
  },
  "kernel": {
    "version": "6.6",
    "config": "config/kernel.config"
  },
  "init": "systemd",
  "bootloader": "grub",
  "output": "build/fyntora.iso"
}